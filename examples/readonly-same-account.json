{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadCredits",
      "Effect": "Allow",
      "Action": ["billing:GetCredits", "aws-portal:ViewBilling"],
      "Resource": "*"
    },
    {
      "Sid": "ReadLightsailMetricsInSelectedRegion",
      "Effect": "Allow",
      "Action": ["lightsail:GetInstance", "lightsail:GetInstanceMetricData"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "ap-northeast-1"}}
    }
  ]
}

